{
  "format": "seamless-workshop-preset-1",
  "mods": [
    {
      "id": "local@seamless-clipboard-manager",
      "enabled": true,
      "settings": {
        "accentColor": "#89B4FA",
        "accentColor2": "#CBA6F7",
        "allowDuplicates": 0,
        "alwaysOnTop": 1,
        "animations": 1,
        "backgroundOpacity": 55,
        "blurMode": "acrylic",
