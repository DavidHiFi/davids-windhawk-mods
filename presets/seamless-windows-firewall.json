        "rememberWindowPosition": 1,
        "replaceFirewallPrompt": 1,
        "restoreAll": "",
        "settingsGlass": 1,
        "settingsTrayIcon": 1,
        "showCycleMs": 0,
        "showCycleWidget": 1,
        "showNonActionableInRunning": 0,
        "showPill": 1,
        "showTooltips": 0,
        "toggleForegroundApp": "Ctrl+Alt+F",
