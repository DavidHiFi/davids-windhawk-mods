    "editor.tokenColorCustomizations": {
        "comments": "#9399b2",
        "strings": "#a6e3a1",
        "keywords": "#cba6f7",
        "numbers": "#fab387",
        "types": "#f9e2af",
        "functions": "#89b4fa",
        "variables": "#cdd6f4",
        "textMateRules": [
            {
                "scope": [
                    "comment",
                    "punctuation.definition.comment"
                ],
                "settings": {
                    "foreground": "#9399b2",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier",
                    "keyword.control"
                ],
                "settings": {
                    "foreground": "#cba6f7"
                }
            },
            {
                "scope": [
                    "keyword.operator",
                    "punctuation.separator",
                    "punctuation.accessor"
                ],
                "settings": {
                    "foreground": "#94e2d5"
                }
            },
            {
                "scope": [
                    "string",
                    "string.quoted"
                ],
                "settings": {
                    "foreground": "#a6e3a1"
                }
            },
            {
                "scope": [
                    "constant.character.escape"
                ],
                "settings": {
                    "foreground": "#f5c2e7"
                }
            },
            {
                "scope": [
                    "constant.numeric",
                    "constant.language"
                ],
                "settings": {
                    "foreground": "#fab387"
                }
            },
            {
                "scope": [
                    "entity.name.function",
                    "support.function"
                ],
                "settings": {
                    "foreground": "#89b4fa"
                }
            },
            {
                "scope": [
                    "entity.name.type",
                    "support.type",
                    "entity.name.class",
                    "entity.name.namespace"
                ],
                "settings": {
                    "foreground": "#f9e2af"
                }
            },
            {
                "scope": [
                    "meta.preprocessor",
                    "keyword.control.directive",
                    "entity.name.function.preprocessor"
                ],
                "settings": {
                    "foreground": "#f5c2e7"
                }
            },
            {
                "scope": [
                    "variable.parameter"
                ],
                "settings": {
                    "foreground": "#eba0ac"
                }
            },
            {
                "scope": [
                    "variable.other.member",
                    "variable.other.property"
                ],
                "settings": {
                    "foreground": "#b4befe"
                }
            },
            {
                "scope": [
                    "punctuation",
                    "meta.brace"
                ],
                "settings": {
                    "foreground": "#9399b2"
                }
            }
        ]
    },
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "function": "#89b4fa",
            "method": "#89b4fa",
            "class": "#f9e2af",
            "type": "#f9e2af",
            "enum": "#f9e2af",
            "enumMember": "#fab387",
            "namespace": "#f9e2af",
            "macro": "#f5c2e7",
            "parameter": "#eba0ac",
            "property": "#b4befe",
            "variable": "#cdd6f4",
            "variable.readonly": "#fab387",
            "comment": "#9399b2"
        }
    }
}
